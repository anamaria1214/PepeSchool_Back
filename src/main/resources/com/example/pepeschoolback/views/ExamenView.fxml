<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">

    <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Gestión de Examenes" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
      <Button fx:id="btnAtras" mnemonicParsing="false" onAction="#cancelar" prefHeight="25.0" prefWidth="119.0" style="-fx-background-color: red;" text="Atrás" textFill="WHITE" />
        <Button fx:id="btnFormularioExamen" onAction="#mostrarFormularioExamen" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Agregar Nuevo Examen" />
    </HBox>

    <TableView fx:id="ExamenTable" style="-fx-pref-height: 400;">
        <columns>
            <TableColumn fx:id="nombreColumn" prefWidth="200" text="Nombre" />
            <TableColumn fx:id="descripcionColum" prefWidth="280" text="Descripcion" />
            <TableColumn fx:id="cantPreguntasColumn" prefWidth="100" text="Cant Preguntas" />
            <TableColumn fx:id="fechaPresenColumn" prefWidth="120" text="Fecha Presentación" />
            <TableColumn fx:id="materiaColumn" prefWidth="100" text="Materia" />
        </columns>
    </TableView>
</VBox>
