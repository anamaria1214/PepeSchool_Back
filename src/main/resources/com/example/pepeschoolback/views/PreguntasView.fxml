<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">

    <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Gestión de Preguntas" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
      <Button fx:id="btnAtras" mnemonicParsing="false" onAction="#cancelar" prefHeight="25.0" prefWidth="107.0" style="-fx-background-color: red;" text="Atrás" textFill="WHITE" />
        <Button fx:id="btnFormularioPregunta" onAction="#mostrarFormularioPregunta" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Agregar Nueva Pregunta" />
    </HBox>

    <TableView fx:id="preguntasTable" style="-fx-pref-height: 400;">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="50" text="ID" />
            <TableColumn fx:id="enunciadoColumn" prefWidth="300" text="Enunciado" />
            <TableColumn fx:id="tipoColumn" prefWidth="150" text="Tipo" />
            <TableColumn fx:id="respuestaColumn" prefWidth="100" text="Respuesta" />
            <TableColumn fx:id="pesoColumn" prefWidth="100" text="Peso" />
        </columns>
    </TableView>
</VBox>
