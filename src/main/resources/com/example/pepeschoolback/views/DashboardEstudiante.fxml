<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="Dashboard - Estudiante" />
            <Label fx:id="lblNombreUsuario" style="-fx-text-fill: white; -fx-font-size: 16;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Cerrar Sesión" />
        </HBox>
    </top>

    <left>
        <VBox spacing="10" style="-fx-background-color: #34495e; -fx-pref-width: 200;">
            <Button style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-pref-width: 180; -fx-pref-height: 40;" text="Exámenes Pendientes" />
            <Button style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-pref-width: 180; -fx-pref-height: 40;" text="Exámenes por Materia" />
            <Button style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-pref-width: 180; -fx-pref-height: 40;" text="Exámenes por Grupo" />
            <Button style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-pref-width: 180; -fx-pref-height: 40;" text="Historial de Exámenes" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <!-- Contenido dinámico se cargará aquí -->

            <!-- Vista por defecto (Exámenes Pendientes) -->
            <VBox fx:id="examenesPendientesView" spacing="15" style="-fx-padding: 20;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="Exámenes Pendientes" />

                <TableView fx:id="tblExamenesPendientes" style="-fx-pref-height: 400;">
                    <columns>
                        <TableColumn fx:id="colMateriaPendiente" prefWidth="150.0" text="Materia" />
                        <TableColumn fx:id="colNombrePendiente" prefWidth="200.0" text="Examen" />
                        <TableColumn fx:id="colFechaLimite" prefWidth="120.0" text="Fecha Límite" />
                        <TableColumn fx:id="colPresentar" prefWidth="120.0" text="Acción" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Vista de Exámenes por Materia (oculta inicialmente) -->
            <VBox fx:id="examenesMateriaView" spacing="15" style="-fx-padding: 20;" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="Exámenes por Materia:" />
                    <ComboBox fx:id="cbMaterias" promptText="Seleccione una materia" style="-fx-pref-width: 200;" />
                </HBox>

                <TableView fx:id="tblExamenesMateria" style="-fx-pref-height: 350;">
                    <columns>
                        <TableColumn fx:id="colNombreMateria" prefWidth="200" text="Examen" />
                        <TableColumn fx:id="colFechaLimiteMateria" prefWidth="120" text="Fecha Límite" />
                        <TableColumn fx:id="colEstadoMateria" prefWidth="100" text="Estado" />
                        <TableColumn fx:id="colPresentarMateria" prefWidth="120" text="Acción" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Vista de Exámenes por Grupo (oculta inicialmente) -->
            <VBox fx:id="examenesGrupoView" spacing="15" style="-fx-padding: 20;" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="Exámenes por Grupo:" />
                    <ComboBox fx:id="cbGrupos" promptText="Seleccione un grupo" style="-fx-pref-width: 200;" />
                </HBox>

                <TableView fx:id="tblExamenesGrupo" style="-fx-pref-height: 350;">
                    <columns>
                        <TableColumn fx:id="colNombreGrupo" prefWidth="200" text="Examen" />
                        <TableColumn fx:id="colMateriaGrupo" prefWidth="150" text="Materia" />
                        <TableColumn fx:id="colFechaLimiteGrupo" prefWidth="120" text="Fecha Límite" />
                        <TableColumn fx:id="colEstadoGrupo" prefWidth="100" text="Estado" />
                        <TableColumn fx:id="colPresentarGrupo" prefWidth="120" text="Acción" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Vista de Historial (oculta inicialmente) -->
            <VBox fx:id="historialView" spacing="15" style="-fx-padding: 20;" visible="false">
                <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="Historial de Exámenes Presentados" />

                <TableView fx:id="tblHistorial" style="-fx-pref-height: 400;">
                    <columns>
                        <TableColumn fx:id="colNombreHistorial" prefWidth="200" text="Examen" />
                        <TableColumn fx:id="colMateriaHistorial" prefWidth="150" text="Materia" />
                        <TableColumn fx:id="colFechaHistorial" prefWidth="120" text="Fecha Presentación" />
                        <TableColumn fx:id="colCalificacion" prefWidth="100" text="Calificación" />
                        <TableColumn fx:id="colResultado" prefWidth="100" text="Resultado" />
                    </columns>
                </TableView>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #ecf0f1; -fx-padding: 10;">
            <Label style="-fx-text-fill: #7f8c8d;" text="Sistema de Evaluación - Versión 1.0" />
        </HBox>
    </bottom>
</BorderPane>
