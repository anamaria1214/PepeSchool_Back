<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="Dashboard - Maestro" />
            <Label fx:id="lblNombreUsuario" style="-fx-text-fill: white; -fx-font-size: 16;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Cerrar Sesión" />
        </HBox>
    </top>

    <left>
        <VBox spacing="10" style="-fx-background-color: #34495e; -fx-pref-width: 200;">
            <Button onAction="#mostrarExamenes" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-pref-width: 180; -fx-pref-height: 40;" text="Mis Examenes" />
            <Button onAction="#mostrarCrearPregunta" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-pref-width: 180; -fx-pref-height: 40;" text="Mis preguntas" />
            <!-- <Button onAction="#mostrarGrupos" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-pref-width: 180; -fx-pref-height: 40;" text="Mis Grupos" /> -->
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <!-- Contenido dinámico se cargará aquí -->

            <!-- Vista por defecto (Mis Exámenes) -->
            <VBox fx:id="examenesView" spacing="15" style="-fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="Mis Grupos" />
                </HBox>
                <TableView fx:id="tblGrupos" style="-fx-pref-height: 400;">
                    <columns>
                        <TableColumn fx:id="colMateria" prefWidth="125" text="Materia" />
                        <TableColumn fx:id="colGrupo" prefWidth="125" text="Grupo" />
                        <TableColumn fx:id="colDia" prefWidth="125" text="Dia" />
                        <TableColumn fx:id="colHora" prefWidth="125" text="Hora" />
                    </columns>
                </TableView>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #ecf0f1; -fx-padding: 10;">
            <Label style="-fx-text-fill: #7f8c8d;" text="Sistema de Evaluación - Versión 1.0" />
        </HBox>
    </bottom>
</BorderPane>
